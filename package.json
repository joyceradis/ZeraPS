{
  "name": "zera-ps",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "for file in *.js assets/*.js src/*.js protocols/*.js; do node --check \"$file\" || exit 1; done",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test",
    "v2:typecheck": "tsc -p tsconfig.v2.json",
    "v2:test": "vitest run --config vite-v2.config.ts",
    "v2:build": "vite build --config vite-v2.config.ts",
    "v2:verify": "npm run v2:typecheck && npm run v2:test && npm run v2:build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "fake-indexeddb": "^6.2.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
